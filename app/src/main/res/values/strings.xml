    <!-- i18n feature texts (ADR-0017) -->
    <string name="ai_feature_summary_label">AI 摘要</string>
    <string name="ai_feature_summary_summary">基于正文生成一段结论 + 2~4 条要点，支持为单个订阅源单独配置摘要提示词。</string>
    <string name="ai_feature_summary_entry">阅读页顶栏 Sparkles 按钮 / 正文区摘要卡；订阅源操作页可配该源专属提示词。</string>
    <string name="ai_feature_summary_presentation">阅读页标题下常驻摘要卡，生成后持久保存，刷新永不覆盖。</string>
    <string name="ai_feature_translate_label">文章翻译</string>
    <string name="ai_feature_translate_summary">把外文正文整体译为简体中文，保留 HTML 结构，可随时切回原文。</string>
    <string name="ai_feature_translate_entry">阅读页顶栏翻译开关；重译走底部操作条。</string>
    <string name="ai_feature_translate_presentation">替换式译文，会话内 LRU 缓存，不落库。</string>
    <string name="ai_feature_classify_label">智能分类</string>
    <string name="ai_feature_classify_summary">判定文章所属话题（科技/财经/开发/设计等），用于话题星系与信息聚合。</string>
    <string name="ai_feature_classify_entry">批处理：每日任务扫描未分类的新文章；也可在阅读页手动重判。</string>
    <string name="ai_feature_classify_presentation">阅读页摘要卡下方的话题 chip；话题星系页按此聚合。</string>
    <string name="ai_feature_tags_label">自动标签</string>
    <string name="ai_feature_tags_summary">抽取 3~6 个细粒度主题标签，比话题分类更具体、可跨话题。</string>
    <string name="ai_feature_tags_entry">批处理：每日任务；阅读页摘要卡下的「重新生成标签」。</string>
    <string name="ai_feature_tags_presentation">阅读页标签 chip 组，长按可复制到剪贴板。</string>
    <string name="ai_feature_sentiment_label">情感分析</string>
    <string name="ai_feature_sentiment_summary">判断报道情绪倾向（正面/中性/负面）与强度，帮助识别带节奏的内容。</string>
    <string name="ai_feature_sentiment_entry">批处理：每日任务；也可在阅读页手动分析。</string>
    <string name="ai_feature_sentiment_presentation">列表卡片右侧的情绪小色条 + 阅读页情绪标签（含强度值）。</string>
    <string name="ai_feature_keywords_label">关键词提取</string>
    <string name="ai_feature_keywords_summary">抽取 5~8 个核心关键词（专有名词优先），与画像词表同源可复用。</string>
    <string name="ai_feature_keywords_entry">批处理：每日任务；阅读页摘要卡下的关键词行。</string>
    <string name="ai_feature_keywords_presentation">阅读页关键词 chip 行；点击即作为搜索词跳转搜索页。</string>
    <string name="ai_feature_opinion_label">观点总结</string>
    <string name="ai_feature_opinion_summary">提炼文章的核心论点与支撑论据，区分「作者观点」与「引用事实」。</string>
    <string name="ai_feature_opinion_entry">阅读页底部操作条「观点」按钮。</string>
    <string name="ai_feature_opinion_presentation">底部弹出的观点卡片：论点列表 + 依据摘要，可折叠。</string>
    <string name="ai_feature_qa_label">文章问答与深度解析</string>
    <string name="ai_feature_qa_summary">针对当前文章提问，模型只依据正文作答，无依据时明说「文中未提及」。</string>
    <string name="ai_feature_qa_entry">阅读页底部「问这篇文章」输入框，支持一键追问（解释/影响/时间线）。</string>
    <string name="ai_feature_qa_presentation">底部问答抽屉：多轮对话，每条回答带「依据段落」引用，不持久化。</string>
    <string name="ai_feature_fulltext_label">AI 正文还原</string>
    <string name="ai_feature_fulltext_summary">规则提取器拿不到正文时，用模型从网页原始 HTML 还原正文。默认关闭，不是正文的常规来源。</string>
    <string name="ai_feature_fulltext_entry">未接线：阅读页不提供入口（规则提取 + 抓取诊断已覆盖正文获取）。</string>
    <string name="ai_feature_fulltext_presentation">成功则替换正文并清除不完整标记，失败如实提示不写脏数据。</string>
    <string name="ai_feature_dedupe_label">智能去重</string>
    <string name="ai_feature_dedupe_summary">识别同一事件的多源转载，给出主篇与相似组，避免重复读同一条新闻。</string>
    <string name="ai_feature_dedupe_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_dedupe_presentation">「AI 结果」页按功能筛选查看，文章级产物可跳原文；专属列表入口待做。</string>
    <string name="ai_feature_quality_label">文章质量分析</string>
    <string name="ai_feature_quality_summary">从信息密度、原创性、标题党程度、证据充分性四个维度给出 0~100 评分。</string>
    <string name="ai_feature_quality_entry">批处理：每日任务；阅读页「质量」按钮可单篇重算。</string>
    <string name="ai_feature_quality_presentation">阅读页质量卡：总分 + 四维条形图 + 一句短板说明。</string>
    <string name="ai_feature_noise_label">智能降噪与内容评分</string>
    <string name="ai_feature_noise_summary">识别广告、水文、AI 批量生成与情绪煽动，输出降噪建议与信息价值分。</string>
    <string name="ai_feature_noise_entry">批处理：每日任务；阅读页「降噪」按钮。</string>
    <string name="ai_feature_noise_presentation">列表卡片右上角的降噪角标（噪声高则灰显）；阅读页降噪说明卡。</string>
    <string name="ai_feature_outline_label">长文精读结构化</string>
    <string name="ai_feature_outline_summary">把长文拆成带小标题的层级大纲，可按节跳转，附一句全篇主旨。</string>
    <string name="ai_feature_outline_entry">阅读页底部「大纲」按钮；正文字数超阈值时主动提示。</string>
    <string name="ai_feature_outline_presentation">底部大纲抽屉：层级列表，点击滚动到对应段落。</string>
    <string name="ai_feature_credibility_label">信源可信度评估</string>
    <string name="ai_feature_credibility_summary">评估信源类型、证据链与断言强度，给出可信度档位与需要留意的信号。</string>
    <string name="ai_feature_credibility_entry">阅读页底部「可信度」按钮。</string>
    <string name="ai_feature_credibility_presentation">可信度卡：档位 label + 依据列举 + 「存疑点」提示，绝不编造事实核查结论。</string>
    <string name="ai_feature_glossary_label">划词解释</string>
    <string name="ai_feature_glossary_summary">选中正文里的术语、缩写或专有名词，给出贴合上下文的一句话解释。</string>
    <string name="ai_feature_glossary_entry">阅读页长按选中文本后的「解释」菜单项。</string>
    <string name="ai_feature_glossary_presentation">底部释义条：一句解释 + 在本文中的含义，不持久化。</string>
    <string name="ai_feature_personal_feed_label">个性化内容推荐</string>
    <string name="ai_feature_personal_feed_summary">推荐流底座：按新鲜度、源亲和度、内容相似度打分并打散（ADR-0013）。</string>
    <string name="ai_feature_personal_feed_entry">信息流「推荐」标签页；设置页可关闭该 tab。</string>
    <string name="ai_feature_personal_feed_presentation">推荐 tab 的文章流，带「减少此类」负反馈与撤销。</string>
    <string name="ai_feature_feed_recommend_label">智能订阅源推荐</string>
    <string name="ai_feature_feed_recommend_summary">基于兴趣画像与已订阅源，推荐值得新增的 RSSHub 路由或站点。</string>
    <string name="ai_feature_feed_recommend_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_feed_recommend_presentation">「AI 结果」页按功能筛选查看；专属「猜你想订」入口待做。</string>
    <string name="ai_feature_discover_label">发现模式</string>
    <string name="ai_feature_discover_summary">一次给一批跨领域的陌生话题文章，专门用于探索而非收敛。</string>
    <string name="ai_feature_discover_entry">专属「发现」入口尚未实现；开启后待专属页接入。</string>
    <string name="ai_feature_discover_presentation">专属探索流尚未实现；有产物时会出现在「AI 结果」页。</string>
    <string name="ai_feature_topic_galaxy_label">话题星系浏览</string>
    <string name="ai_feature_topic_galaxy_summary">把已分类文章聚成话题簇，按热度与亲疏排布，看清自己的阅读版图。</string>
    <string name="ai_feature_topic_galaxy_entry">专属「话题星系」入口尚未实现；依赖智能分类产物。</string>
    <string name="ai_feature_topic_galaxy_presentation">专属星系页尚未实现；有产物时会出现在「AI 结果」页。</string>
    <string name="ai_feature_bubble_break_label">信息茧房破壁</string>
    <string name="ai_feature_bubble_break_summary">找出画像覆盖不到的盲区话题，主动推几篇对立视角或陌生领域的文章。</string>
    <string name="ai_feature_bubble_break_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_bubble_break_presentation">「AI 结果」页按功能筛选查看；信息流「换个视角」卡片待做。</string>
    <string name="ai_feature_related_label">文章关联推荐</string>
    <string name="ai_feature_related_summary">读某篇时给出内容相关的其他文章（跨源），复用推荐引擎的内容相似度。</string>
    <string name="ai_feature_related_entry">阅读页底部「相关阅读」横滑条；纯本地相似度，不调模型、不耗额度。</string>
    <string name="ai_feature_related_presentation">阅读页底部横滑卡片：标题 + 来源，点击跳转原文；无候选时不显示。</string>
    <string name="ai_feature_aggregate_label">智能信息聚合</string>
    <string name="ai_feature_aggregate_summary">把同一话题下多篇文章合成一份综述，保留分歧而不是抹平。</string>
    <string name="ai_feature_aggregate_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_aggregate_presentation">「AI 结果」页按功能筛选查看；专属综述页待做。</string>
    <string name="ai_feature_interest_rank_label">个人兴趣排序</string>
    <string name="ai_feature_interest_rank_summary">用模型给画像词表做可读化命名与归并，产出「你最关心什么」的排序。</string>
    <string name="ai_feature_interest_rank_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_interest_rank_presentation">「AI 结果」页按功能筛选查看；兴趣画像页集成待做。</string>
    <string name="ai_feature_event_merge_label">同源事件合并阅读</string>
    <string name="ai_feature_event_merge_summary">同一事件的多篇报道合成一条时间线，看清事件演进与各源口径差异。</string>
    <string name="ai_feature_event_merge_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_event_merge_presentation">「AI 结果」页按功能筛选查看；专属时间线页待做。</string>
    <string name="ai_feature_cold_start_label">兴趣冷启动引导</string>
    <string name="ai_feature_cold_start_summary">新用户勾选几个关注领域即可生成初始画像，跳过「推荐流空转」阶段。</string>
    <string name="ai_feature_cold_start_entry">专属引导卡尚未实现。</string>
    <string name="ai_feature_cold_start_presentation">专属勾选页尚未实现；有产物时会出现在「AI 结果」页。</string>
    <string name="ai_feature_daily_brief_label">AI 每日简报</string>
    <string name="ai_feature_daily_brief_summary">把当天新文章压缩成一份简报：几条要闻 + 与你相关的部分 + 可跳过清单。</string>
    <string name="ai_feature_daily_brief_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_daily_brief_presentation">「AI 结果」页按功能筛选查看；专属简报页与通知跳转待做。</string>
    <string name="ai_feature_share_copy_label">生成分享文案</string>
    <string name="ai_feature_share_copy_summary">为一篇文章生成适合不同平台的分享文案（短评/长推/要点体）。</string>
    <string name="ai_feature_share_copy_entry">阅读页顶栏分享按钮里的「AI 生成文案」。</string>
    <string name="ai_feature_share_copy_presentation">文案选择弹层：三种风格卡片，点选即复制并唤起系统分享。</string>
    <string name="ai_feature_smart_notify_label">智能通知</string>
    <string name="ai_feature_smart_notify_summary">新文章先过一遍重要度判定，只推送值得打断你的那些，其余静默。</string>
    <string name="ai_feature_smart_notify_entry">批处理：自动同步后判定；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_smart_notify_presentation">「AI 结果」页按功能筛选查看；通知栏集成待做。</string>
    <string name="ai_feature_feed_health_label">订阅源健康监控</string>
    <string name="ai_feature_feed_health_summary">结合抓取日志与更新频率，诊断订阅源是否失效、降频或内容质量下滑。</string>
    <string name="ai_feature_feed_health_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_feed_health_presentation">「AI 结果」页按功能筛选查看（订阅源级产物可跳该源）；专属报告页待做。</string>
    <string name="ai_feature_habit_label">阅读习惯分析</string>
    <string name="ai_feature_habit_summary">分析活跃时段、阅读时长分布、订阅源集中度，指出信息摄入的偏食点。</string>
    <string name="ai_feature_habit_entry">每日任务；「我的」页的「阅读习惯」入口。</string>
    <string name="ai_feature_habit_presentation">习惯报告页：时段热力 + 源集中度 + 三条可执行的观察结论。</string>
    <string name="ai_feature_daily_report_label">每日阅读报告</string>
    <string name="ai_feature_daily_report_summary">汇总当天读了什么、花了多久、错过了什么，给一句中肯的总结。</string>
    <string name="ai_feature_daily_report_entry">批处理：每日任务；AI 功能总览页展开后可「立即运行」。</string>
    <string name="ai_feature_daily_report_presentation">「AI 结果」页按功能筛选查看；专属报告页与次日通知待做。</string>
    <string name="ai_feature_filter_rule_label">智能过滤规则生成</string>
    <string name="ai_feature_filter_rule_summary">用自然语言描述「不想看到什么」，生成关键词过滤规则供确认后启用。</string>
    <string name="ai_feature_filter_rule_entry">专属「过滤规则」入口尚未实现。</string>
    <string name="ai_feature_filter_rule_presentation">规则确认页尚未实现；有产物时会出现在「AI 结果」页。</string>
    <string name="ai_feature_usage_label">AI 用量看板</string>
    <string name="ai_feature_usage_summary">统计今日/累计调用次数、输入输出字数、失败率与预估费用。</string>
    <string name="ai_feature_usage_entry">设置 → AI 与诊断 → 「AI 用量」入口。</string>
    <string name="ai_feature_usage_presentation">用量页：数字卡 + 按功能的调用排行 + 日预算进度条。</string>
    <string name="ai_feature_task_queue_label">AI 任务队列</string>
    <string name="ai_feature_task_queue_summary">所有后台 AI 任务的排队、限速、重试与失败留痕，可手动清空与重跑。</string>
    <string name="ai_feature_task_queue_entry">设置 → AI 与诊断 → 「AI 任务队列」入口。</string>
    <string name="ai_feature_task_queue_presentation">队列页：按状态分组的任务列表 + 失败原因 + 重试/清空操作。</string>
    <string name="ai_feature_prompt_template_label">提示词模板管理</string>
    <string name="ai_feature_prompt_template_summary">集中管理全局提示词与各订阅源的摘要提示词覆盖，支持预览与恢复默认。</string>
    <string name="ai_feature_prompt_template_entry">设置 → AI 与诊断 → 「提示词模板」；订阅源操作页可配单源提示词。</string>
    <string name="ai_feature_prompt_template_presentation">管理页：内置模板原文预览 + 各源覆盖列表（编辑/清除），支持变量占位符。</string>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则。

  云备份与设备间直传**都**排除 rssradar_secrets.xml（DeepSeek API Key）：
  凭据只该留在本机，用户换机时重填一次即可。其余设置不受影响。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rssradar_secrets.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rssradar_secrets.xml"/>
    </device-transfer>
</data-extraction-rules>

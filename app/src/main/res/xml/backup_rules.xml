<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下的备份规则（Android 12+ 见 data_extraction_rules.xml）。

  API Key 存在 rssradar_secrets 里，**绝不能上传云端**：Google 云备份与
  旧机型的 `adb backup` 都能把 shared_prefs 整份导出。普通设置仍照常备份，
  换机后可恢复，只是 API Key 需要用户重填一次。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="rssradar_secrets.xml"/>
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 新文章通知（#31）：Android 13+ 需运行时授权，设置页在用户开启时请求 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 音频/播客后台播放：media3 的 MediaSessionService 走前台服务，
         Android 14+ 必须显式声明 mediaPlayback 类型，否则 startForeground 抛异常 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- RSS 生态仍有 http 源，MVP 阶段放行明文流量 -->
    <application
        android:usesCleartextTraffic="true"
        android:name=".RssRadarApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RssRadar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RssRadar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享（#34）：别的 App 分享链接/文字时，RssRadar 出现在分享单里 -->
            <intent-filter android:label="@string/intent_subscribe">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 选中文字的浮动菜单（#34）：选中的文本里有链接就能直接订阅 -->
            <intent-filter android:label="@string/intent_subscribe">
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 外部直达：rssradar://article/{id} → NavHost 解析落到 ArticleDetailRoute（issue #32） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="article"
                    android:scheme="rssradar" />
            </intent-filter>
        </activity>

        <!-- 音频/播客播放（media3）：MediaSessionService 承载播放器，通知栏控制与
             后台播放由它提供；播放器本身活在服务里，退出播放页不中断。 -->
        <service
            android:name="com.cycling.rssradar.core.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>

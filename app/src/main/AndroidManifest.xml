<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 新文章通知（#31）：Android 13+ 需运行时授权，设置页在用户开启时请求 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- RSS 生态仍有 http 源，MVP 阶段放行明文流量 -->
    <application
        android:usesCleartextTraffic="true"
        android:name=".RssRadarApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RssRadar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RssRadar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 外部直达：rssradar://article/{id} → NavHost 解析落到 ArticleDetailRoute（issue #32） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="article"
                    android:scheme="rssradar" />
            </intent-filter>
        </activity>
    </application>

</manifest>
